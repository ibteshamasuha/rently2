rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper Functions
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return isExistingUser() && ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "";
    }

    function isAdmin() {
      return isSignedIn() && (userRole() == "admin" || userRole() == "Admin");
    }

    function isTenantUser() {
      return isSignedIn() && (
        !isExistingUser()
        || userRole() in ["tenant", "both", "Tenant", "Both"]
        || isAdmin()
      );
    }

    function isLandlordUser() {
      return isSignedIn() && (
        !isExistingUser()
        || userRole() in ["landlord", "both", "Landlord", "Both"]
        || isAdmin()
      );
    }


    // =========================
    // Users
    // =========================

    match /users/{userId} {
      // 1. Strict read isolation:
      // Only the authenticated owner of this UID or an admin may read this document.
      // Tenants cannot read other tenants; landlords cannot read other landlords.
      allow read: if isOwner(userId) || isAdmin();

      // 2. Account creation:
      // Must match the authenticated UID. Self-service cannot assign "admin" role.
      allow create: if isOwner(userId)
        && (
          request.resource.data.role in ["tenant", "landlord", "both"]
          || isAdmin()
        );

      // 3. Profile update:
      // Admins have full administrative update rights.
      // Regular users can only update non-sensitive profile fields (e.g. name, phone).
      // They are strictly forbidden from modifying role, identity (uid), email, or createdAt.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
          && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        );

      // 4. Deletion: The account owner or administrator can delete the user account.
      allow delete: if isOwner(userId) || isAdmin();
    }


    // =========================
    // Apartments
    // =========================

    match /apartments/{apartmentId} {

      // 1. Read:
      // - Published/available apartments are discoverable by tenants and all signed-in users.
      // - Landlords can read their own apartments (available, pending, rented, draft).
      // - Admins can read all apartments.
      // - Landlords CANNOT access another landlord's private/non-available apartments.
      allow read: if isSignedIn()
        && (
          resource == null
          || resource.data.status in ["available", "Available"]
          || resource.data.landlordId == request.auth.uid
          || ('currentTenantId' in resource.data && resource.data.currentTenantId == request.auth.uid)
          || isAdmin()
        );

      // 2. Create:
      // - Caller must be signed in with role 'landlord', 'both', or 'admin'.
      // - The apartment's landlordId MUST strictly equal request.auth.uid.
      // - Never trusts a client-supplied foreign landlord UID.
      allow create: if isSignedIn()
        && (isLandlordUser() || isAdmin())
        && request.resource.data.landlordId == request.auth.uid;

      // 3. Update:
      // - Only the owning landlord or an admin can update.
      // - Landlord A CANNOT update Landlord B's apartment.
      // - landlordId is immutable: cannot change landlordId or assign apartment to another landlord.
      allow update: if isSignedIn()
        && (
          (
            userRole() in ["landlord", "both"]
            && resource.data.landlordId == request.auth.uid
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.landlordId == request.auth.uid
          )
          || isAdmin()
        );

      // 4. Delete:
      // - Only the owning landlord or an admin can delete the apartment.
      // - Landlord A CANNOT delete Landlord B's apartment.
      allow delete: if isSignedIn()
        && (
          (
            userRole() in ["landlord", "both"]
            && resource.data.landlordId == request.auth.uid
          )
          || isAdmin()
        );
    }


    // =========================
    // Rent Records
    // =========================

    match /rent_records/{recordId} {

      allow read: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && (
          (userRole() in ["landlord", "both"] && request.resource.data.landlordId == request.auth.uid)
          || isAdmin()
        );

      allow update: if isSignedIn()
        && (
          (
            userRole() in ["landlord", "both"]
            && resource.data.landlordId == request.auth.uid
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
          || isAdmin()
        );

      allow delete: if isAdmin()
        || (isSignedIn() && userRole() in ["landlord", "both"] && resource.data.landlordId == request.auth.uid);
    }


    // =========================
    // Notices
    // =========================

    match /notices/{noticeId} {

      // Landlords read notices they authored; tenants read public or targeted notices; admin reads all
      allow read: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.isPublic == true
          || resource.data.targetTenantId == request.auth.uid
          || isAdmin()
        );

      allow create: if isSignedIn()
        && (isLandlordUser() || isAdmin())
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            userRole() in ["landlord", "both"]
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
          )
        );

      allow delete: if isSignedIn()
        && (
          isAdmin()
          || (userRole() in ["landlord", "both"] && resource.data.authorId == request.auth.uid)
        );
    }


    // =========================
    // Rental Requests
    // =========================

    match /rentalRequests/{requestId} {

      // 1. Read:
      // - Tenant can read ONLY their own rental requests.
      // - Landlord can read ONLY requests targeting apartments owned by them.
      // - Landlord A CANNOT see rental requests belonging to Landlord B's apartments.
      // - Admin has broad administrative read access.
      allow read: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid
          || isAdmin()
        );

      // 2. Create:
      // - Tenant can create a request ONLY for themselves (request.resource.data.tenantId == request.auth.uid).
      // - Tenant cannot pretend to be another tenant.
      // - Initial status must be 'pending'.
      // - Prevents landlordId tampering: if apartment exists in Firestore, landlordId MUST match the apartment's actual landlordId.
      allow create: if isSignedIn()
        && (isTenantUser() || isAdmin())
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == "pending"
        && (
          !exists(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId))
          || request.resource.data.landlordId == get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data.landlordId
        );

      // 3. Update:
      // - Landlord can approve/reject ONLY requests for their own apartments.
      // - Landlord A CANNOT approve/reject Landlord B's rental request.
      // - Tenant can update/cancel ONLY their own pending request.
      // - Critical IDs (tenantId, landlordId, apartmentId) are strictly immutable.
      allow update: if isSignedIn()
        && (
          // Landlord / Admin approving or rejecting:
          (
            (
              (userRole() in ["landlord", "both"] && resource.data.landlordId == request.auth.uid)
              || isAdmin()
            )
            && request.resource.data.status in ["approved", "rejected", "pending"]
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
          // Tenant cancelling or modifying their own pending request:
          || (
            resource.data.tenantId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status in ["cancelled", "pending"]
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
        );

      // 4. Delete:
      // - Only the owning landlord, admin, or the applicant tenant (while pending) can delete.
      allow delete: if isSignedIn()
        && (
          (userRole() in ["landlord", "both"] && resource.data.landlordId == request.auth.uid)
          || (resource.data.tenantId == request.auth.uid && resource.data.status == "pending")
          || isAdmin()
        );
    }


    // =========================
    // Maintenance Requests
    // =========================

    match /maintenanceRequests/{requestId} {

      // 1. Read:
      // - Tenant can see ONLY maintenance requests they submitted (resource.data.tenantId == request.auth.uid).
      // - Landlord can see ONLY maintenance requests associated with their own apartments (resource.data.landlordId == request.auth.uid).
      // - Landlord A CANNOT see maintenance requests for Landlord B's apartments.
      // - Admin has broad administrative read access.
      allow read: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid
          || isAdmin()
        );

      // 2. Create:
      // - Tenant can create a request ONLY for themselves (request.resource.data.tenantId == request.auth.uid).
      // - Tenant cannot submit a request pretending to be another tenant.
      // - Initial status must be 'pending'.
      // - If apartment exists in Firestore, landlordId MUST match the apartment's actual landlordId.
      allow create: if isSignedIn()
        && (isTenantUser() || isAdmin())
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == "pending"
        && (
          !exists(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId))
          || (
            request.resource.data.landlordId == get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data.landlordId
            && (
              !('currentTenantId' in get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data)
              || get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data.currentTenantId == request.auth.uid
              || isAdmin()
            )
          )
        );

      // 3. Update:
      // - Landlord can update status/details ONLY for maintenance requests belonging to their own apartments.
      // - Landlord A CANNOT modify Landlord B's maintenance request.
      // - Tenant can update details/cancel ONLY their own pending maintenance request.
      // - Critical IDs (tenantId, landlordId, apartmentId) are strictly immutable.
      allow update: if isSignedIn()
        && (
          // Landlord / Admin updating status/details:
          (
            (
              (userRole() in ["landlord", "both"] && resource.data.landlordId == request.auth.uid)
              || isAdmin()
            )
            && request.resource.data.status in ["pending", "in-progress", "completed", "rejected"]
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
          // Tenant updating their own pending request:
          || (
            resource.data.tenantId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
        );

      // 4. Delete:
      // - Only the owning landlord, admin, or the applicant tenant (while pending) can delete.
      allow delete: if isSignedIn()
        && (
          (userRole() in ["landlord", "both"] && resource.data.landlordId == request.auth.uid)
          || (resource.data.tenantId == request.auth.uid && resource.data.status == "pending")
          || isAdmin()
        );
    }


    // =========================
    // Apartment Queries / Pre-Rental Inquiries
    // =========================

    match /apartment_queries/{queryId} {

      // 1. Read:
      // Only the tenant who asked the question, the owning landlord, or an admin can read.
      // Tenants cannot read another tenant's questions.
      // Landlord A cannot read queries for Landlord B's apartments.
      allow read: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid
          || isAdmin()
        );

      // 2. Create:
      // Must be created by an authenticated user where tenantId strictly equals request.auth.uid.
      // Initial status must be "pending".
      // Prevents landlord tampering: if apartment doc exists and has landlordId, landlordId must match.
      allow create: if isSignedIn()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == "pending"
        && (
          !exists(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId))
          || !('landlordId' in get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data)
          || request.resource.data.landlordId == get(/databases/$(database)/documents/apartments/$(request.resource.data.apartmentId)).data.landlordId
        );

      // 3. Update:
      // Only the owning landlord or admin can update (e.g. reply to inquiry).
      // Relationship IDs (tenantId, landlordId, apartmentId) remain strictly immutable.
      allow update: if isSignedIn()
        && (
          (
            (
              resource.data.landlordId == request.auth.uid
              || isAdmin()
            )
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.landlordId == resource.data.landlordId
            && request.resource.data.apartmentId == resource.data.apartmentId
          )
        );

      // 4. Delete:
      // Both the asking tenant and the owning landlord (or admin) can delete their inquiry (Issue 10)
      allow delete: if isSignedIn()
        && (
          resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid
          || isAdmin()
        );
    }

    // =========================
    // User-Specific Notifications
    // =========================

    match /notifications/{notificationId} {

      // 1. Read:
      // A user can read ONLY notifications specifically addressed to them (recipientId == request.auth.uid).
      // Tenant cannot read Landlord's or other tenants' notifications.
      // Landlord cannot read another landlord's or tenant's private notifications.
      allow read: if isSignedIn()
        && (
          resource.data.recipientId == request.auth.uid
          || isAdmin()
        );

      // 2. Create:
      // Any authenticated user can generate a legitimate notification for an event.
      // recipientId must be a valid non-empty string.
      allow create: if isSignedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0;

      // 3. Update:
      // Only the recipient can mark the notification as read.
      // recipientId is strictly immutable.
      allow update: if isSignedIn()
        && (
          resource.data.recipientId == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.recipientId == resource.data.recipientId;

      // 4. Delete:
      // User can delete their own eligible notifications (Issue 10).
      allow delete: if isSignedIn()
        && (
          resource.data.recipientId == request.auth.uid
          || isAdmin()
        );
    }
  }
}