rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Apartment photos: only the owning landlord can upload, modify, or delete
    match /apartments/{landlordId}/{apartmentId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == landlordId;
    }

    // User profile images: only the owning user can write or delete
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
